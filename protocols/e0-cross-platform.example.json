{
  "protocol_id": "e0-cross-platform",
  "version": 1,
  "description": "Cross-platform comparison protocol for the E0 synthetic-Doppler artifact (e0-results.json). This example's tolerances are placeholders: copy the file to a measured protocol only after the PR-4 cross-platform report supplies the observed error bounds.",
  "tolerance_status": "example_only",
  "tolerance_note": "PLACEHOLDER TOLERANCES, NOT MEASUREMENTS. Do not cite a numerically_equivalent result produced with this file as a reproduction. Fill the final abs_tol/rel_tol values from the measured cross-platform report (see protocols/README.md) and record that report digest in the protocol.",
  "levels": {
    "r0_execution": "Both artifacts parse as strict JSON, contain the required top-level structure, and contain every (condition, trial) exactly once with the same condition set and order.",
    "r1_numerical_equivalence": "Every exact field matches exactly and every numeric field satisfies |a-b| <= abs_tol + rel_tol*max(|a|,|b|), across all 2500 trial records and all condition aggregates.",
    "r2_bitwise_identity": "The PCJ-0 canonical JSON of both artifacts, after removing only the ignored fields, is byte-identical (equal SHA-256)."
  },
  "exact_fields": [
    "experiment",
    "config.c_sound_m_s",
    "config.snr_definition",
    "config.fitted_model",
    "config.seed_formula",
    "config.front_end.method",
    "config.front_end.frame_len",
    "config.front_end.hop",
    "config.front_end.f_min_hz",
    "config.front_end.f_max_hz",
    "config.front_end.sample_rate_hz",
    "config.n_trials_per_condition",
    "config.n_conditions",
    "config.tolerances.f0_rel",
    "config.tolerances.v_rel",
    "config.tolerances.t0_abs_s",
    "config.tolerances.b_rel",
    "config.tolerances.accept_improvement",
    "conditions[].condition",
    "conditions[].group",
    "conditions[].note",
    "conditions[].n",
    "conditions[].success.k",
    "conditions[].success.n",
    "conditions[].success.fail_components.*",
    "conditions[].b0.success.k",
    "conditions[].scenario.*",
    "trials[].condition",
    "trials[].trial",
    "trials[].seed",
    "trials[].b1.iterations",
    "trials[].b1.n_starts_ranked",
    "trials[].b1.n_starts",
    "trials[].b1.success",
    "trials[].b1.converged",
    "trials[].b1.within_tol.*",
    "trials[].b0.success",
    "trials[].b0.valid",
    "trials[].b0.within_tol.*",
    "trials[].accepted"
  ],
  "numeric_fields": [
