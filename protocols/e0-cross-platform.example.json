  "ignored_fields": [
    "generated_at_utc",
    "elapsed_s",
    "config.jobs",
    "records_sha256",
    "environment.python",
    "environment.numpy",
    "environment.platform",
    "environment.machine",
    "environment.cpu_count"
  ],
  "structural_rules": {
    "required_keys": [
      "experiment",
      "generated_at_utc",
      "config",
      "environment",
      "elapsed_s",
      "records_sha256",
      "conditions",
      "trials"
    ],
    "trials_key": "trials",
    "conditions_key": "conditions",
    "trial_key": ["condition", "trial"],
    "condition_key": "condition",
    "required_trial_keys": ["condition", "trial", "seed", "b1", "b0", "accepted"],
    "same_condition_set": true,
    "same_condition_order": true,
    "exactly_once": true,
    "no_duplicates": true,
    "no_missing": true,
    "no_extra": true
  },
  "decision_instability": {
    "decision_fields": [
      "trials[].b1.success",
      "trials[].b1.converged",
      "trials[].b1.within_tol.*",
      "trials[].b0.success",
      "trials[].b0.valid",
      "trials[].b0.within_tol.*",
      "trials[].accepted"
    ],
    "parameter_scope": "trial"
  },
  "unclassified_field_policy": "exact"
}
