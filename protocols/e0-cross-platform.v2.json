      },
      {
        "abs_tol": 0.005,
        "path": "trials[].b1.params.f0",
        "rel_tol": 1e-05,
        "scope": "trial"
      },
      {
        "abs_tol": 0.0025,
        "path": "trials[].b1.params.v",
