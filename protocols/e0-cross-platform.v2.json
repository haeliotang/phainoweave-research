      },
      {
        "abs_tol": 1e-06,
        "path": "conditions[].b0.rel_abs.*.*",
        "rel_tol": 0.0,
        "scope": "condition"
      },
      {
        "abs_tol": 1e-06,
        "path": "conditions[].b0.t0_abs_err.*",
        "rel_tol": 0.0,
        "scope": "condition"
      },
      {
        "abs_tol": 1e-12,
        "path": "conditions[].b0.rms_hz.*",
        "rel_tol": 1e-05,
        "scope": "condition"
      },
      {
        "abs_tol": 1e-09,
        "path": "conditions[].front_end.*.*",
        "rel_tol": 1e-05,
        "scope": "condition"
      }
    ],
    "C_unidentifiable_diagnostic": [
      {
        "decades": 0,
        "path": "trials[].b1.iterations",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 0,
        "path": "trials[].b1.n_starts_ranked",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 0,
        "path": "trials[].b1.n_starts",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "trials[].b1.grad_norm",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "trials[].b1.se.*",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "trials[].b1.corr.*",
        "semantics": "magnitude_class",
        "sign_sensitive": true
      },
      {
