      },
      {
        "abs_tol": 1e-12,
        "path": "trials[].b1.rms_hz",
        "rel_tol": 1e-05,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-12,
        "path": "trials[].b1.sigma_f_hz",
        "rel_tol": 1e-05,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "trials[].b1.improvement_ratio",
        "rel_tol": 0.0,
        "scope": "trial"
      },
      {
        "abs_tol": 0.03,
        "path": "trials[].b0.params.*",
        "rel_tol": 1e-05,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "trials[].b0.rel.*",
        "rel_tol": 0.0,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-09,
        "path": "trials[].b0.rms_hz",
        "rel_tol": 1e-05,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "trials[].b0.improvement_ratio",
        "rel_tol": 0.0,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "conditions[].b1.rel.*.*",
        "rel_tol": 0.0,
        "scope": "condition"
      },
      {
        "abs_tol": 1e-06,
        "path": "conditions[].b1.rel_abs.*.*",
        "rel_tol": 0.0,
        "scope": "condition"
      },
      {
        "abs_tol": 1e-06,
        "path": "conditions[].b1.t0_abs_err.*",
        "rel_tol": 0.0,
        "scope": "condition"
      },
      {
        "abs_tol": 1e-12,
        "path": "conditions[].b1.rms_hz.*",
        "rel_tol": 1e-05,
