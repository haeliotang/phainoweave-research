        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "trials[].b1.rel.b",
        "rel_tol": 0.0,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-12,
        "path": "trials[].b1.sse",
        "rel_tol": 1e-05,
