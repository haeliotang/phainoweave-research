        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "trials[].b1.rel.f0",
        "rel_tol": 0.0,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "trials[].b1.rel.v",
        "rel_tol": 0.0,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "trials[].b1.rel.t0",
        "rel_tol": 0.0,
        "scope": "trial"
      },
      {
        "abs_tol": 1e-06,
        "path": "trials[].b1.rel.t0_abs",
