      },
      {
        "decades": 1,
        "path": "trials[].b1.worst_dir.*",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 0,
        "path": "conditions[].b1.iterations.*",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "conditions[].b1.grad_norm.*",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "conditions[].b1.worst_rel_se.*",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "conditions[].b1.condition_number.*",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "conditions[].b1.corr_abs.*.*",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "conditions[].b1.corr_signed.*.*",
        "semantics": "magnitude_class",
        "sign_sensitive": true
      },
      {
        "decades": 1,
        "path": "conditions[].b1.worst_dir.*.*",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "conditions[].b1.cov_available_rate",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "conditions[].success.wilson_lo",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "conditions[].success.wilson_hi",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "trials[].b1.se",
        "semantics": "magnitude_class",
        "sign_sensitive": false
      },
      {
        "decades": 1,
        "path": "trials[].b1.corr",
        "semantics": "magnitude_class",
        "sign_sensitive": true
      },
      {
        "decades": 1,
        "path": "trials[].b1.corr_abs",
