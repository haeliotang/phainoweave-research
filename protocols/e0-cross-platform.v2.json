      "config.*",
      "conditions[].condition",
      "conditions[].group",
      "conditions[].note",
      "conditions[].n",
      "conditions[].scenario.*",
      "conditions[].success.n",
      "trials[].condition",
      "trials[].trial",
      "trials[].seed"
    ],
    "B_identifiable_numeric": [
